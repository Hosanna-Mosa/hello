# app/.env.example — copy to `app/.env` and edit. `.env` is gitignored.
#
# ─────────────────────────────────────────────────────────────────────────────
#  READ THIS BEFORE ADDING ANYTHING
#
#  Every EXPO_PUBLIC_* value is INLINED INTO THE APP BUNDLE at build time.
#  It ships inside the .apk and anyone can read it out with `strings` or by
#  unzipping the archive. It is configuration, NOT a secret.
#
#  So: API URLs, feature flags and timeouts belong here.
#  API keys, tokens, signing secrets and database passwords DO NOT — putting
#  one here publishes it to every person who installs the app.
#
#  Anything genuinely secret lives on the server, in `backend/.env`.
# ─────────────────────────────────────────────────────────────────────────────
#
#  NOTHING READS THIS FILE YET.
#
#  `app/src/services/client.ts` is still the in-memory mock — there is no
#  `fetch`, no `process.env` and no `EXPO_PUBLIC` anywhere in `app/src`. This
#  file documents the switchover ahead of it, so the variables are agreed
#  before the code depends on them.
#
#  Expo only exposes variables prefixed `EXPO_PUBLIC_`. Values are inlined at
#  bundle time, so after editing this file you must restart Metro:
#
#      npx expo start --clear
#
#  A plain reload will keep serving the old values.


# Which data layer the app runs against.
#
#   mock    the in-memory service layer. No server needed, works offline, and
#           what the 482 tests run against. This is the default and stays the
#           default until the switchover lands.
#
#   <url>   a running backend, e.g. http://192.168.1.5:4000
#           Use the Mac's LAN IP, NOT localhost — on a physical phone
#           `localhost` is the phone itself, which is the single most common
#           reason "it works in the simulator but not on device".
#           No trailing slash. The client appends /v1 itself.
EXPO_PUBLIC_API=http://192.168.1.5:4000


# How long a request may take before it is aborted, in milliseconds.
#
# The mock transport has no timeout at all, which is part of why the real
# client needs one: a phone on a weak connection otherwise hangs a screen
# forever with no error state.
EXPO_PUBLIC_API_TIMEOUT_MS=15000


# Socket.IO endpoint, for live chat, typing indicators and incoming calls.
#
# Leave blank to derive it from EXPO_PUBLIC_API, which is correct whenever the
# API and the socket share an origin — they do today. Set it only if the
# socket is ever served from a different host.
EXPO_PUBLIC_SOCKET_URL=


# ─────────────────────────────────────────────────────────────────────────────
#  Deliberately absent, and why
#
#  EXPO_PUBLIC_JWT_SECRET      the app never signs a token; the server does
#  EXPO_PUBLIC_MONGO_URI       the app never touches the database
#  EXPO_PUBLIC_SMS_API_KEY     OTP delivery is server-side
#
#  If you find yourself wanting one of these, the work belongs on the server.
# ─────────────────────────────────────────────────────────────────────────────
