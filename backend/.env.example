# Copy to .env and fill in. `.env` is gitignored; this file is not.
# Generate every secret with:  openssl rand -base64 48

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# LOCAL for now. Atlas connection string drops in here later — it is a one-line
# change and nothing else moves.
#
# A dedicated database name keeps this project's collections away from the
# other projects already in this mongod.
#
# This local mongod is a STANDALONE: no multi-document transactions. That is
# fine for Phases 1-3 (auth, profile, taxonomy, discovery) which write one
# document at a time. Phase 4 onwards needs Atlas (or a replica set), which is
# why REQUIRE_TRANSACTIONS exists.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=hello_dev

# Atlas, for later. Cluster -> Connect -> Drivers -> Node.js.
# Never paste a real one into a chat or a commit.
# MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Phases 1-3: false. Flip to true when Phase 4 starts, or on Atlas.
REQUIRE_TRANSACTIONS=false

REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=hello:dev

# No defaults on purpose. A server that boots without these is a security bug.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PHONE_PEPPER=
CURSOR_SECRET=

ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=2592000

# Returns the OTP in the HTTP response instead of sending an SMS.
# The server REFUSES TO BOOT if this is true while NODE_ENV=production.
OTP_DEV_MODE=true
OTP_TTL_SEC=300
OTP_RESEND_SEC=30

# Voice message audio. Must be writable by the API process. In production the
# systemd unit's StateDirectory=hello creates /var/lib/hello for exactly this.
VOICE_DIR=./data/voice

# Store-review sign-in: this email + password opens a session on the EXISTING
# account registered with REVIEW_LOGIN_PHONE (E.164). Leave all three unset to
# disable it. Never put these in the app.
REVIEW_LOGIN_EMAIL=
REVIEW_LOGIN_PASSWORD=
REVIEW_LOGIN_PHONE=

FREE_DAILY_LIKES=15

# '*' is refused in production.
CORS_ORIGINS=*

# Where the 40 seeded demo people live.
#
# Defaults to London, matching the app's mock data. Override it to wherever the
# demo is happening: discovery caps at 100 km, so a tester further away than
# that sees a correctly empty deck with no way to tell it from a bug.
# Re-run `npm run seed` after changing these.
SEED_ANCHOR_LAT=51.5074
SEED_ANCHOR_LNG=-0.1278
