# ─────────────────────────────────────────────────────────────────────────────
#  PRODUCTION ENV — copy to `.env` ON THE SERVER, fill in, chmod 600.
#
#  Never commit this filled in. Never paste a filled-in copy into a chat: a
#  secret that has appeared in a transcript is a secret that must be rotated
#  (PLAN #84 is exactly that, still outstanding).
#
#  Generate every secret ON THE SERVER with:   openssl rand -base64 48
#  Four separate values. Reusing one across two purposes means one leak is two.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# ── Mongo ───────────────────────────────────────────────────────────────────
#  MUST support multi-document transactions. `REQUIRE_TRANSACTIONS=true` is
#  forced in production and `/ready` returns 503 without them: accepting a
#  message request writes a match, a thread, a seed message and a status flip,
#  and a partial write there is a corrupt account nobody notices until a demo.
#
#  CHOSEN SETUP — mongod on this host as a SINGLE-NODE REPLICA SET. The replica
#  set is not for redundancy; it is what makes transactions available at all. One
#  node is enough. `deploy/provision.sh` installs and initiates it, and PROVES
#  transactions by committing one rather than reading the config.
#
#    MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
#
#  `127.0.0.1:27017` must match the host in `rs.initiate()` exactly — the driver
#  discovers members by the names the set reports, so a hostname there that does
#  not resolve to loopback here fails after connecting.
#
#  Atlas also works (a replica set by definition): paste its connection string,
#  lock Network Access to this server's IP, and use a NEW least-privilege user —
#  the old password appeared in a transcript and was never rotated (PLAN #84).
#
#  A plain standalone mongod will NOT boot this server.
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGO_DB=hello
REQUIRE_TRANSACTIONS=true` is
#  forced in production and `/ready` returns 503 without them. Accepting a
#  message request writes a match, a thread, a seed message and a status flip;
#  a partial write there is a corrupt account nobody notices until a demo.
#
#  Two ways to satisfy it:
#    a) Atlas — a replica set by definition. Lock Network Access to this
#       server's IP only, and use a least-privilege database user.
#    b) mongod on this server as a SINGLE-NODE REPLICA SET (replSetName: rs0,
#       then rs.initiate()). Bind it to 127.0.0.1 — see the Redis note below,
#       it applies just as much here.
#  A plain standalone mongod will NOT boot this server.
MONGO_URI=
MONGO_DB=hello
REQUIRE_TRANSACTIONS=true

# ── Redis ───────────────────────────────────────────────────────────────────
#  BIND TO 127.0.0.1 AND FIREWALL IT. On a bare VPS Redis is exposed unless
#  someone says otherwise, and an open Redis is the most common way this stack
#  gets breached. Verify with `ss -lntp | grep 6379` — it must show 127.0.0.1,
#  never 0.0.0.0. Redis holds the refresh-token allowlist: whoever reaches it
#  can mint sessions.
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=hello:prod

# ── Secrets — no defaults, on purpose ───────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PHONE_PEPPER=
CURSOR_SECRET=

ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=2592000

# ── OTP delivery ────────────────────────────────────────────────────────────
#  OTP_DEV_MODE returns the login code in the HTTP RESPONSE. The server REFUSES
#  TO BOOT with it true here, and rightly: on a public host it would let anyone
#  sign in as any phone number.
OTP_DEV_MODE=false
#
#  OTP_LOG_ONLY prints the code to the server log and returns nothing, so
#  reading it needs shell access to this machine. With neither flag set, no SMS
#  provider is wired and EVERY SIGN-IN FAILS — so for a test deploy this is
#  true, and the cost is stated plainly: anyone who can read these logs can
#  sign in as anybody. Set it false the day a provider is wired in
#  src/services/sms.service.ts.
OTP_LOG_ONLY=true
OTP_TTL_SEC=300
OTP_RESEND_SEC=30

# Voice message audio. Must be writable by the API process. In production the
# systemd unit's StateDirectory=hello creates /var/lib/hello for exactly this.
VOICE_DIR=/var/lib/hello/voice

# Store-review sign-in: this email + password opens a session on the EXISTING
# account registered with REVIEW_LOGIN_PHONE (E.164). Leave all three unset to
# disable it. Never put these in the app.
REVIEW_LOGIN_EMAIL=
REVIEW_LOGIN_PASSWORD=
REVIEW_LOGIN_PHONE=

# ── CORS ────────────────────────────────────────────────────────────────────
#  '*' is refused in production. The mobile app sends no Origin, so this only
#  matters for a browser; set it to the site that will call the API, or to this
#  API's own origin if nothing will.
CORS_ORIGINS=https://api.example.com

FREE_DAILY_LIKES=15

# ── Voice calls: STUN and TURN ──────────────────────────────────────────────
#  STUN alone is enough for two phones on the same wifi, and NOT enough across
#  two mobile networks — a carrier-grade NAT will not let them meet directly.
#  Without TURN those calls ring, connect-fail, and end. That is the single
#  most likely "calls don't work" report.
#
#  coturn on this server, then:
#    TURN_URLS=turn:api.example.com:3478?transport=udp,turn:api.example.com:3478?transport=tcp
#    TURN_SECRET=<the `static-auth-secret` from /etc/turnserver.conf>
#  The server mints time-limited credentials from that secret
#  (src/services/ice.service.ts) — the shared secret itself never leaves it.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_SECRET=
TURN_TTL_SEC=600

# ── Seed ────────────────────────────────────────────────────────────────────
#  Where the 40 demo people live. Discovery caps at 100 km, so a tester further
#  than that sees a correctly empty deck that is indistinguishable from a bug.
#  Set these near wherever the phones actually are, then re-run `npm run seed`.
SEED_ANCHOR_LAT=51.5074
SEED_ANCHOR_LNG=-0.1278
