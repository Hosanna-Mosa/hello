# Leave empty in development: Vite proxies /v1 to the API (same origin, so the
# HttpOnly session cookie is first-party). In production either serve the
# panel on the API's host, or set this AND list the panel's origin in the
# API's ADMIN_ORIGINS.
VITE_API_URL=
# Where the dev proxy sends /v1.
VITE_DEV_API_TARGET=http://localhost:4000
